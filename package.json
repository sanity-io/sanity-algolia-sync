{
  "name": "algolia-sync-function",
  "description": "Algolia Sync Function Example",
  "keywords": [
    "Sanity",
    "Next.js",
    "Headless CMS",
    "Visual Editing",
    "Live Content API (LCAPI)",
    "Real-time"
  ],
  "homepage": "https://github.com/sanity-io/sanity-template-nextjs-clean#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/sanity-template-nextjs-clean/issues"
  },
  "workspaces": [
    "studio",
    "frontend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel --print-label dev:*",
    "dev:next": "npm run dev --workspace=frontend",
    "dev:studio": "npm run dev --workspace=studio",
    "format": "prettier --cache --write .",
    "import-sample-data": "cd studio && sanity dataset import sample-data.tar.gz --replace",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "npm run type-check --workspaces",
    "sync:algolia": "cd studio && npm run sync:algolia"
  },
  "prettier": "@sanity/prettier-config",
  "devDependencies": {
    "@sanity/blueprints": "0.2.0",
    "@sanity/prettier-config": "^2.0.1",
    "npm-run-all2": "^5.0.2",
    "prettier": "^3.6.2",
    "tsx": "^4.7.0"
  },
  "dependencies": {
    "@sanity/cli": "^4.8.1",
    "@sanity/client": "^7.11.1",
    "algoliasearch": "^5.0.0",
    "dotenv": "^17.2.2",
    "next": "^15.5.8",
    "sanity": "^4.8.1"
  }
}
